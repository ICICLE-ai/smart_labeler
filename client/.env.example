# Smart Labeler frontend (client/) — environment variables.
#
# Copy to .env and fill in.
#
# `npm run dev` DOES read .env (verified: both the URLs and ANNOTATOR_TYPE take
# effect). Production does not — `npm start` runs remix-serve, which reads only
# the real process environment, so set these in your container or k8s env there.
#
# They are read server-side in app/root.tsx's loader and handed to the browser as
# runtime config, so they are injectable at container start with no rebuild. That
# also means they are visible to anyone who views the page — never put a secret
# here.

# ── Backends ────────────────────────────────────────────────────────────────
# The Smart Labeler backend (server/).
API_BASE_URL=http://127.0.0.1:11112

# Per-image SAM3 inference (/predict) — used by single-click and text-prompt
# segmentation on still images and on video frames.
SAM3_ENDPOINT=https://sam3-sailab.nrp-nautilus.io

# The SAM3 *video* service, for video segmentation and tracking. Point this at
# the auth gateway when one is deployed, or at the service itself (commonly a
# local SSH tunnel to a GPU node) when it is not.
SAM3_VIDEO_URL=http://127.0.0.1:2129

# "gateway" when SAM3_VIDEO_URL points at the authenticating gateway; anything
# else (or unset) for a direct connection.
#
# This must match the deployment. Set to "gateway" against a bare service and
# every request fails CORS, because the service answers with a wildcard allowed
# origin and browsers refuse to pair that with credentials. Left unset against a
# gateway, no session cookie is sent and every request is refused with 401.
SAM3_VIDEO_AUTH=none

TAPIS_BASE_URL=https://icicleai.tapis.io

# ── Which annotator this instance is ────────────────────────────────────────
# DETECTION | SEGMENTATION | VIDEO_SEGMENTATION, or empty for a tabbed view of
# all three. Setting it hides the other types entirely, including their existing
# pipelines — an empty dashboard after changing this usually means the pipelines
# are of a different type, not that they are gone.
ANNOTATOR_TYPE=DETECTION

# ── Optional lists (unset = built-in defaults) ──────────────────────────────
# Tapis systems offered in the file browsers, as a JSON array.
# ALLOWED_SYSTEMS=[{"value":"pitzer-tapis","label":"Pitzer (OSC)"}]

# Comma-separated model names shown in the pipeline configuration steps.
# EMBEDDERS=OWLv2 Large Patch14 Ensemble,DINOv3 ViT-S/16 (LVD-1689M Pretrained)
# PROPOSERS=Segment Anything Model 3 (SAM 3),OWLv2 Large Patch14 Ensemble

# ── Help links ──────────────────────────────────────────────────────────────
# DOC_URL=
# DEMO_VIDEO_URL=

# The dev server's port is a CLI flag, not an environment variable:
#   npm run dev -- --port 5180
# In production `npm start` runs remix-serve, which honours PORT.
