{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../packages/*/src/**/*.ts",
    "../packages/*/src/**/*.tsx",
    "**/.server/**/*.ts",
    "**/.server/**/*.tsx",
    "**/.client/**/*.ts",
    "**/.client/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "app/components/DropzoneButton/DropzoneButton.tsx",
    "app/components/DropzoneButton/DropzoneFile.tsx",
    "app/components/DropzoneButton/useFileOperations.ts",
    "app/components/DropzoneButton/DropzoneButton.story.tsx",
    "app/components/HeroImageBackground/HeroImageBackground.story.tsx"
  ],
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["@types/node", "vite/client"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"],
      "@icicle-ai/image-annotation-canvas": ["../packages/image-annotation-canvas/src/index.ts"],
      "@icicle-ai/annotation-details": ["../packages/annotation-details/src/index.ts"],
      "@icicle-ai/tapis-file-explorer": ["../packages/tapis-file-explorer/src/index.ts"],
      "@icicle-ai/image-annotator": ["../packages/image-annotator/src/index.ts"],
      "@icicle-ai/patra-model-selector": ["../packages/patra-model-selector/src/index.ts"],
      "@icicle-ai/video-segmentation": ["../packages/video-segmentation/src/index.ts"]
    },
    "noEmit": true
  }
}
