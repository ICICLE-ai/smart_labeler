Bootstrap: docker
From: python:3.12-bullseye

# Build from this folder:  apptainer build protorcd_embed.sif embed.def
# Run:  apptainer run --nv --bind /path/to/weights:/weights protorcd_embed.sif \
#           --coco /data/out/proposals.coco.json --image_dir /data/images \
#           --output_dir /data/out/embeddings \
#           --dinov3_weights /weights/dinov3_vith16plus_pretrain_lvd1689m-7c1da9a5.pth

%files
    ../LICENSE /app/protorcd/LICENSE
    __init__.py /app/protorcd/embed/__init__.py
    bioclip.py /app/protorcd/embed/bioclip.py
    crops.py /app/protorcd/embed/crops.py
    dinov3.py /app/protorcd/embed/dinov3.py
    insid3_debias.py /app/protorcd/embed/insid3_debias.py
    masks.py /app/protorcd/embed/masks.py
    proposals.py /app/protorcd/embed/proposals.py
    run_embed.py /app/protorcd/embed/run_embed.py

%environment
    export PATH="/usr/local/bin:$PATH"
    export PYTHONPATH="/app/protorcd:$PYTHONPATH"
    # Local DINOv3 checkout so torch.hub needs no network at runtime. Weights are gated
    # and NOT baked in: pass --dinov3_weights (or PROTORCD_DINOV3_WEIGHTS).
    export PROTORCD_DINOV3_REPO=/opt/dinov3
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%post
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        libgl1-mesa-glx \
        libglib2.0-0
    rm -rf /var/lib/apt/lists/*

    python3 -m pip install --upgrade pip
    pip install --no-cache-dir \
        numpy \
        Pillow \
        torch \
        torchvision \
        tqdm \
        pycocotools \
        pybioclip \
        open-clip-torch

    git clone --depth 1 https://github.com/facebookresearch/dinov3.git /opt/dinov3
    if [ -f /opt/dinov3/requirements.txt ]; then
        pip install --no-cache-dir -r /opt/dinov3/requirements.txt
    fi

    chmod -R a+rX /app/protorcd /opt/dinov3
    chmod 755 /app/protorcd/embed/run_embed.py

%runscript
    exec python3 /app/protorcd/embed/run_embed.py "$@"

%labels
    Maintainer "Brijesh Nanda <brundayogananda.1@osu.edu>"
    Version "1.0"
    Appname "ProtoRCD Embed"
    Description "ProtoRCD DINOv3 / BioCLIP proposal embeddings keyed by COCO annotation id"
