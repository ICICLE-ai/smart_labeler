{
  "name": "smart-labeler-packages",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "image-annotation-canvas",
    "annotation-details",
    "tapis-file-explorer",
    "patra-model-selector",
    "image-annotator",
    "video-segmentation"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "clean": "npm run clean --workspaces",
    "version:all": "npm version --workspaces --no-git-tag-version",
    "pin-deps": "node scripts/pin-workspace-deps.mjs",
    "release:dry": "npm run pin-deps && npm run build && npm publish --workspaces --dry-run",
    "release": "npm run pin-deps && npm run build && npm publish --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsup": "^8.3.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1"
  }
}
