{
  "name": "@icicle-ai/image-annotation-canvas",
  "version": "0.1.1",
  "description": "A zoomable/pannable image canvas for bounding-box detection and polygon segmentation annotation, with optional SAM3-assisted labeling.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "@mui/material": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "@mui/icons-material": "^5.0.0 || ^6.0.0 || ^7.0.0",
    "react-zoom-pan-pinch": "^3.0.0"
  },
  "devDependencies": {
    "react": "^18.2.1",
    "react-dom": "^18.2.0",
    "@mui/material": "^7.3.1",
    "@mui/icons-material": "^7.3.1",
    "react-zoom-pan-pinch": "^3.7.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "tsup": "^8.3.5"
  },
  "keywords": [
    "react",
    "image-annotation",
    "bounding-box",
    "segmentation",
    "canvas",
    "sam3",
    "computer-vision"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ICICLE-ai/smart_labeler.git",
    "directory": "packages/image-annotation-canvas"
  }
}
