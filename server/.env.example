# Smart Labeler backend (server/) — environment variables.
#
# IMPORTANT: this backend does NOT read a .env file — it has no python-dotenv
# dependency and never calls load_dotenv. A .env placed here is silently
# ignored. Use this file as the reference list and set the values in the real
# environment:
#
#   export $(grep -v '^#' .env.example | grep -v '^$' | xargs)   # a shell
#   envFrom: [configMapRef: ...]                                  # kubernetes
#   env_file: .env                                                # docker compose
#
# Every value below has a default in the code, so the service starts without any
# of them — which is exactly why a deployment can look healthy while pointing at
# the wrong database or redirecting logins to localhost. Set them explicitly.
#
# NOTE: environment variables are only half the configuration. The OAuth client
# credentials live in a YAML file instead — see APP_CONFIG_PATH at the bottom.

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
# No sensible default exists for this. The code falls back to a developer's own
# username, so leaving it unset fails against a real database in a way that
# looks like a permissions problem rather than a missing setting.
DB_USER=
DB_PASSWORD=
DB_POOL_MIN=2
DB_POOL_MAX=20
# Retries on startup, for a database that is still coming up.
DB_CONNECT_ATTEMPTS=5

# ── Login / session ─────────────────────────────────────────────────────────
# Where users are sent back to after the Tapis OAuth round-trip. Must be the
# real frontend URL: the default sends everyone to localhost after signing in.
FRONT_URL=https://your-frontend.example.edu
# Domain the tapis-token cookie is set on. It must cover the frontend's host, or
# the browser silently drops the cookie and the user appears signed out.
COOKIE_DOMAIN=your-frontend.example.edu
# Set true for any HTTPS deployment; browsers reject Secure cookies over http,
# and accept non-Secure ones in fewer and fewer cross-site contexts.
COOKIE_SECURE=true

TAPIS_BASE_URL=https://icicleai.tapis.io
TENANT=icicleai
# Pre-selected Tapis system in the file browsers.
DEFAULT_SYSTEM=expanse-tapis-static

# ── Patra model registry ────────────────────────────────────────────────────
PATRA_BASE_NEW=https://patrabackend.pods.icicleai.tapis.io

# ── HPC job submission ──────────────────────────────────────────────────────
# Container images for the detection/classification pipeline steps. These have
# no defaults: unset, they are submitted to Tapis as a null sourceUrl and the
# job fails at launch. Not needed for video segmentation.
SMART_LABELER_CLASS_SUPPORT_IMAGE=
SMART_LABELER_PROPOSAL_GENERATION_IMAGE=
SMART_LABELER_CLASSIFICATION_IMAGE=

# Resources requested per submitted job.
HPC_MAX_RUNTIME_MINUTES=210
HPC_MEMORY_MB=64800
HPC_CORES_PER_NODE=8
HPC_NUMBER_OF_NODES=1

# ── The other half: OAuth credentials in YAML ───────────────────────────────
# Read by iciflaskn.config, not by this file. Defaults to ./config.yaml, which
# is committed with placeholder credentials (client_id: user / client_key: pass)
# — override it rather than editing the committed copy, and keep real secrets
# out of git.
#
#   client_id:      <Tapis OAuth client id>
#   client_key:     <Tapis OAuth client secret>
#   tapis_base_url: https://icicleai.tapis.io
#   tenant:         icicleai
#   app_base_url:   <this backend's own public URL>
#
# app_base_url builds the OAuth callback as {app_base_url}/oauth2/callback, so a
# wrong value breaks login even when every variable above is correct.
APP_CONFIG_PATH=./config.yaml

# The server listens on 0.0.0.0:11112. That is not configurable by environment —
# it is hardcoded, or passed as --host/--port on the command line.
